{
  "name": "@usememos/ui",
  "version": "0.0.0",
  "description": "The Memos UI design system: tokens, foundation styles and React components for usememos products.",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "base-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usememos/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/usememos/ui",
  "bugs": {
    "url": "https://github.com/usememos/ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint && attw --pack --profile esm-only --exclude-entrypoints ./tokens.css ./styles.css"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  }
}
